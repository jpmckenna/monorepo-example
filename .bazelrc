common --enable_bzlmod
# Suppress transitive-dep version mismatch noise; keep warnings for direct deps.
common --check_direct_dependencies=warning

# aspect_rules_ts requires explicit choices for skipLibCheck and transpiler.
common --@aspect_rules_ts//ts:skipLibCheck=always
build --@aspect_rules_ts//ts:default_to_tsc_transpiler

build --java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21

build --incompatible_strict_action_env

test --test_output=errors
test --test_summary=detailed

build --remote_cache=grpcs://remote.buildbuddy.io
build --bes_backend=grpcs://remote.buildbuddy.io
build --bes_results_url=https://app.buildbuddy.io/invocation/
build --remote_timeout=600s
build --remote_download_minimal

try-import %workspace%/.bazelrc.user
