"""Customer-facing storefront — React + TS + Vite.

Domain: shopping. Allowed deps: //libs/ui-kit and the React npm packages.
Forbidden: any //apps/* peer, //libs/common-domain (JVM-only).
"""

load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")

# ts_project provides type-checking and .d.ts generation; Vite handles bundling.
ts_project(
    name = "storefront_lib",
    srcs = glob(
        include = [
            "src/**/*.ts",
            "src/**/*.tsx",
        ],
    ),
    declaration = True,
    tsconfig = "tsconfig.json",
    visibility = ["//apps/storefront:__subpackages__"],
    deps = [
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/@monorepo-example/ui-kit",
        "//apps/orders-service:orders_lib",
    ],
)

# vite_inputs bundles everything Vite needs: HTML, config, TS sources, and npm deps.
js_library(
    name = "vite_inputs",
    srcs = [
        "index.html",
        "vite.config.ts",
    ] + glob(["src/**/*.ts", "src/**/*.tsx", "public/**/*"]),
    deps = [
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/@monorepo-example/ui-kit",
        "//:node_modules/vite",
        "//:node_modules/@vitejs/plugin-react",
    ],
    visibility = ["//apps/storefront:__subpackages__"],
)

vite_bin.vite_binary(
    name = "dev",
    args = ["dev"],
    chdir = package_name(),
    data = [
        ":vite_inputs",
    ],
)

# vite_binary (js_binary) can't capture output dirs; use js_run_binary for the
# production build so dist/ is a declared Bazel output.
vite_bin.vite_binary(
    name = "_vite_build_bin",
    chdir = package_name(),
    data = [
        ":vite_inputs",
    ],
)

js_run_binary(
    name = "build",
    tool = ":_vite_build_bin",
    args = ["build"],
    chdir = package_name(),
    srcs = [
        ":vite_inputs",
    ],
    out_dirs = ["dist"],
)
