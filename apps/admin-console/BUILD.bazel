"""Internal ops console — React + TS + Vite.

Domain: ops. Mirrors storefront but is a peer, not a sibling — they share only
//libs/ui-kit and pnpm packages.
"""

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")

ts_project(
    name = "admin_console_lib",
    srcs = glob(
        include = [
            "src/**/*.ts",
            "src/**/*.tsx",
        ],
    ),
    declaration = True,
    tsconfig = "tsconfig.json",
    visibility = ["//apps/admin-console:__subpackages__"],
    deps = [
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//libs/ui-kit",
    ],
)

js_library(
    name = "vite_inputs",
    srcs = [
        "index.html",
        "vite.config.ts",
    ],
    visibility = ["//apps/admin-console:__subpackages__"],
)

vite_bin.vite_binary(
    name = "dev",
    args = ["dev"],
    chdir = package_name(),
    data = [
        ":admin_console_lib",
        ":vite_inputs",
    ],
)

vite_bin.vite_binary(
    name = "build",
    args = ["build"],
    chdir = package_name(),
    data = [
        ":admin_console_lib",
        ":vite_inputs",
    ],
    out_dirs = ["dist"],
)
