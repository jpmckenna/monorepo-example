"""Shared Java types used by catalog-service and orders-service.

Visibility is intentionally narrow — only the two backend services and their
subpackages can depend on this. Frontend domains never reach into Java.
"""

load("@contrib_rules_jvm//java:defs.bzl", "java_test_suite")
load("@rules_java//java:defs.bzl", "java_library")

java_library(
    name = "common-domain",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = [
        "//apps/catalog-service:__subpackages__",
        "//apps/orders-service:__subpackages__",
    ],
)

java_test_suite(
    name = "tests",
    size = "small",
    srcs = glob(["src/test/java/**/*.java"]),
    runner = "junit5",
    deps = [
        ":common-domain",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
)
